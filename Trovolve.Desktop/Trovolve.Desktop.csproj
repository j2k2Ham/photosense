<Project Sdk="Microsoft.NET.Sdk">
  <!-- What only a computer has: Windows' own picture decoder, its own programs to open a file in, its disks to
       browse, its Recycle Bin. A phone has its own ways of doing these, and none of this goes into its app. -->
  <PropertyGroup>
    <TargetFramework>$(TrovolveTarget)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trovolve.Domain\Trovolve.Domain.csproj" />
  </ItemGroup>
</Project>
