<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app on an Android phone: the page, in a web view whose requests are answered inside the app, on the photos
       of the phone's own storage. Only what talks to Android is here; everything else is shared with the computer and
       tested there (MediaFileSystem, PhotosOnAndroidTests). -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Android 11: where the media store moves photos between folders and keeps a bin. -->
    <SupportedOSPlatformVersion>30</SupportedOSPlatformVersion>
    <RootNamespace>Trovolve.AndroidApp</RootNamespace>
    <ApplicationTitle>Trovolve</ApplicationTitle>
    <ApplicationId>com.j2k2ham.trovolve</ApplicationId>
    <!-- Its version, and the build number Google asks to rise with every upload, come from version.json (Directory.Build.targets). -->
    <TrovolvePart>android</TrovolvePart>
    <!-- The answers are written as JSON by reflection, as on the computer, and LiteDB maps its records the same way:
         only the framework's own assemblies are trimmed, and reflection stays on. -->
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Every package the app ships, those its packages bring among them, is listed in packages.lock.json, from which
         its third-party notices are written where the app cannot be restored (tools/notices.mjs). android.yml fails
         when its restore writes a different list. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The page built for the app; a build elsewhere, without this computer's own settings in it, can be named instead. -->
    <TrovolvePage Condition="'$(TrovolvePage)' == ''">..\Trovolve.ReactUI\out</TrovolvePage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trovolve.Api\Trovolve.Api.csproj" />
    <ProjectReference Include="..\Trovolve.Infrastructure\Trovolve.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <!-- Google Play Billing: buying, restoring and managing Pro (PlayBillingStore). -->
    <PackageReference Include="Xamarin.Android.Google.BillingClient" Version="9.1.0.2" />
    <!-- Google's code scanner, which reads a computer's pairing code without the app needing the camera (Jamie, 2026-11-13). -->
    <PackageReference Include="Xamarin.GooglePlayServices.Code.Scanner" Version="116.1.0.17" />
    <!-- Automatic backup with the app closed: WorkManager wakes the app on Wi-Fi. -->
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.12.0" />
    <!-- Compressing large videos to HEVC on the phone (Jamie, 2026-11-17). -->
    <PackageReference Include="Xamarin.AndroidX.Media3.Transformer" Version="1.11.1" />
    <!-- What is in a photo, for search, named on the phone by Google Play services' own model, which the app does not bundle (Jamie, 2026-11-18). -->
    <PackageReference Include="Xamarin.GooglePlayServices.MLKit.ImageLabeling" Version="116.0.8.20" />
  </ItemGroup>
  <ItemGroup>
    <!-- The page, built for a program that hands it out itself: in Trovolve.ReactUI,
         NEXT_PUBLIC_API_BASE=/api npm run build, which leaves it in out/. -->
    <AndroidAsset Include="$(TrovolvePage)\**\*" Link="Assets\wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The app's icon is kept once, for every program, in branding/. Android 8 and later draw the adaptive icon in
         mipmap-anydpi-v26 instead, each launcher giving it its own shape; this is the plain picture behind it. -->
    <AndroidResource Include="..\branding\app-icon.png" Link="Resources\mipmap\appicon.png" LogicalName="mipmap\appicon.png" />
    <!-- The widgets' feature icons, kept once in branding/ with the others; each widget tints its own. -->
    <AndroidResource Include="..\branding\android\feature-icons\ic_feature_swipe.xml" Link="Resources\drawable\feature_swipe.xml" LogicalName="drawable\feature_swipe.xml" />
    <AndroidResource Include="..\branding\android\feature-icons\ic_feature_storage.xml" Link="Resources\drawable\feature_storage.xml" LogicalName="drawable\feature_storage.xml" />
    <!-- Photos for the self-check to add to the phone, in the copy GitHub's emulator checks only. -->
    <AndroidAsset Include="$(TrovolveSamples)\*" Link="Assets\samples\%(Filename)%(Extension)" Condition="'$(TrovolveSamples)' != ''" />
    <!-- Shown under About: what this app ships that others made (node tools/notices.mjs writes it). -->
    <EmbeddedResource Include="..\notices\android.txt" LogicalName="Trovolve.ThirdPartyNotices.txt" />
  </ItemGroup>
  <Target Name="RequireThePage" BeforeTargets="Build" Condition="!Exists('$(TrovolvePage)\index.html')">
    <Error Text="Build the page first: in Trovolve.ReactUI, run npm ci, then npm run build with NEXT_PUBLIC_API_BASE set to /api." />
  </Target>
</Project>
