<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ builds the icon from layers, so each launcher can give it its own shape; older phones use mipmap/appicon.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/appicon_background" />
  <foreground android:drawable="@drawable/appicon_foreground" />
  <monochrome android:drawable="@drawable/appicon_monochrome" />
</adaptive-icon>
