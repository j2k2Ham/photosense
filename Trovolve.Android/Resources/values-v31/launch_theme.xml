<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Android 12's splash screen: the mark on teal black, before the page's launch animates it in. -->
  <style name="Trovolve.Launch" parent="@android:style/Theme.DeviceDefault.NoActionBar">
    <item name="android:windowBackground">@color/launch_background</item>
    <item name="android:windowSplashScreenBackground">@color/launch_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/appicon_foreground</item>
  </style>
</resources>
