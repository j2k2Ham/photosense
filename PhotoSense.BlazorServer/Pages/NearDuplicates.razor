@page "/near"
@inject PhotoSense.Application.Scanning.Interfaces.IDuplicateAnalysisService Analysis

<h3>Similar Photos (review only)</h3>

@if (groups is null)
{
    <em>Loading...</em>
}
else if (groups.Count == 0)
{
    <p>No similar photos found.</p>
}
else
{
    <table class="table table-sm">
        <thead><tr><th>Best</th><th>Count</th><th>Files</th></tr></thead>
        <tbody>
        @foreach (var g in groups)
        {
            <tr>
                <td>@g.Keeper.FileName</td>
                <td>@g.Members.Count</td>
                <td>
                    @foreach (var m in g.Members)
                    {
                        <div>@m.Photo.FileName</div>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<PhotoSense.Domain.DTOs.DuplicateGroup>? groups;

    protected override async Task OnInitializedAsync()
    {
        groups = (await Analysis.GetAsync()).Similar;
    }
}
