<?xml version="1.0" encoding="utf-8"?>
<!-- 36: the app icon's menu. Each opens PhotoSense saying what to open, as a tapped notification does. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <shortcut android:shortcutId="search" android:enabled="true" android:icon="@drawable/shortcut_search" android:shortcutShortLabel="@string/shortcut_search">
    <intent android:action="android.intent.action.VIEW" android:targetPackage="com.j2k2ham.photosense" android:targetClass="com.j2k2ham.photosense.MainActivity">
      <extra android:name="photosense-opens" android:value="search" />
    </intent>
  </shortcut>
  <shortcut android:shortcutId="swipe" android:enabled="true" android:icon="@drawable/shortcut_swipe" android:shortcutShortLabel="@string/shortcut_swipe">
    <intent android:action="android.intent.action.VIEW" android:targetPackage="com.j2k2ham.photosense" android:targetClass="com.j2k2ham.photosense.MainActivity">
      <extra android:name="photosense-opens" android:value="swipe" />
    </intent>
  </shortcut>
  <shortcut android:shortcutId="backup" android:enabled="true" android:icon="@drawable/shortcut_backup" android:shortcutShortLabel="@string/shortcut_backup">
    <intent android:action="android.intent.action.VIEW" android:targetPackage="com.j2k2ham.photosense" android:targetClass="com.j2k2ham.photosense.MainActivity">
      <extra android:name="photosense-opens" android:value="backup" />
    </intent>
  </shortcut>
</shortcuts>
