<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(TrovolveSharedTargets)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trovolve.Domain\Trovolve.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Its services register themselves (AddTrovolveApplication), with the settings they read. -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0" />
    <!-- What its services write to the program's log; each host decides where that goes. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
  </ItemGroup>
</Project>
