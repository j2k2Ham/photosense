<Project Sdk="Microsoft.NET.Sdk">
  <!-- The service's endpoints, apart from any one program that serves them: the service on a computer
       hands its requests here, and so can an app on a phone. Nothing here may need a particular host or system. -->
  <PropertyGroup>
    <TargetFrameworks>$(TrovolveSharedTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trovolve.Domain\Trovolve.Domain.csproj" />
    <ProjectReference Include="..\Trovolve.Application\Trovolve.Application.csproj" />
    <ProjectReference Include="..\Trovolve.Contracts\Trovolve.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Who makes Trovolve, and the documents the About window shows as the web site does (site/pages). -->
    <EmbeddedResource Include="..\product.json" LogicalName="Trovolve.About.product.json" />
    <EmbeddedResource Include="..\site\pages\*.md" LogicalName="Trovolve.About.%(Filename)%(Extension)" />
    <!-- The one copy of the icon, which the page shows as its own. -->
    <EmbeddedResource Include="..\branding\app-icon.png" LogicalName="Trovolve.About.app-icon.png" />
  </ItemGroup>
</Project>
