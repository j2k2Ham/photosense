<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>PhotoSense</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/AppIcon.appiconset</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>PhotoSense finds copies of the same photo and sorts photos into albums. Nothing leaves this phone unless you send it to your computer.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>PhotoSense sends the photos you choose to PhotoSense on your computer, over your Wi-Fi.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_photosense._tcp</string>
        <string>_photosense-pc._tcp</string>
    </array>
    <key>NSFaceIDUsageDescription</key>
    <string>PhotoSense uses Face ID to unlock Hidden.</string>
    <key>NSCameraUsageDescription</key>
    <string>PhotoSense uses the camera only to scan the pairing code on your computer.</string>
    <key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
    <true/>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
      <string>com.j2k2ham.photosense.storage-check</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
      <string>fetch</string>
    </array>
    <!-- The home screen widgets open PhotoSense with photosense://opens/backup, /swipe or /free-up-space. -->
    <key>CFBundleURLTypes</key>
    <array>
      <dict>
        <key>CFBundleURLName</key>
        <string>com.j2k2ham.photosense</string>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>photosense</string>
        </array>
      </dict>
    </array>
    <!-- 36: the app icon's menu. -->
    <key>UIApplicationShortcutItems</key>
    <array>
      <dict>
        <key>UIApplicationShortcutItemType</key>
        <string>search</string>
        <key>UIApplicationShortcutItemTitle</key>
        <string>Search photos</string>
        <key>UIApplicationShortcutItemIconSymbolName</key>
        <string>magnifyingglass</string>
      </dict>
      <dict>
        <key>UIApplicationShortcutItemType</key>
        <string>swipe</string>
        <key>UIApplicationShortcutItemTitle</key>
        <string>Start swipe</string>
        <key>UIApplicationShortcutItemIconSymbolName</key>
        <string>rectangle.on.rectangle</string>
      </dict>
      <dict>
        <key>UIApplicationShortcutItemType</key>
        <string>backup</string>
        <key>UIApplicationShortcutItemTitle</key>
        <string>Back up now</string>
        <key>UIApplicationShortcutItemIconSymbolName</key>
        <string>arrow.up.to.line.compact</string>
      </dict>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>SceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
</dict>
</plist>
