<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app on an iPhone or iPad: the page, in a web view whose requests are answered inside the app, on the
       phone's own photo library. Only what talks to Apple's frameworks is here; everything else is shared with
       the computer and tested there. It builds only where Apple's tools are (a Mac, or GitHub's), so it is not
       part of PhotoSense.sln. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <RootNamespace>PhotoSense.iOS</RootNamespace>
    <ApplicationTitle>PhotoSense</ApplicationTitle>
    <ApplicationId>com.j2k2ham.photosense</ApplicationId>
    <!-- Its version, and the build number Apple asks to rise with every upload, come from version.json
         (Directory.Build.targets). -->
    <PhotoSensePart>iphone</PhotoSensePart>
    <!-- The answers are written as JSON by reflection, as they are on the computer, and LiteDB maps its records the
         same way: only the framework's own assemblies are trimmed, and reflection stays on. -->
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- LiteDB makes its queries from compiled expressions, code made while the app runs, which iOS allows only through
         .NET's interpreter: everything is still compiled ahead of time, and only code made that way is interpreted. -->
    <MtouchInterpreter>-all</MtouchInterpreter>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PhotoSense.Api\PhotoSense.Api.csproj" />
    <ProjectReference Include="..\PhotoSense.Infrastructure\PhotoSense.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- The page, built for a program that hands it out itself: in PhotoSense.ReactUI,
         NEXT_PUBLIC_API_BASE=/api npm run build, which leaves it in out/. -->
    <BundleResource Include="..\PhotoSense.ReactUI\out\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Without it, App Store Connect refuses the upload. -->
    <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
    <!-- The app's icon is kept once, for every program, in branding/; Xcode makes every size the phone needs from it. -->
    <ImageAsset Include="..\branding\app-icon.png" Link="Assets.xcassets\AppIcon.appiconset\AppIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shown under About: what this app ships that others made (node tools/notices.mjs writes it). -->
    <EmbeddedResource Include="..\notices\iphone.txt" LogicalName="PhotoSense.ThirdPartyNotices.txt" />
  </ItemGroup>
  <Target Name="RequireThePage" BeforeTargets="Build" Condition="!Exists('..\PhotoSense.ReactUI\out\index.html')">
    <Error Text="Build the page first: in PhotoSense.ReactUI, run npm ci, then npm run build with NEXT_PUBLIC_API_BASE set to /api." />
  </Target>
</Project>
