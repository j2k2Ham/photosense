{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "clean (service)",
			"command": "dotnet",
			"args": [
				"clean",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"type": "process",
			"problemMatcher": "$msCompile",
			"options": {
				"cwd": "${workspaceFolder}/PhotoSense.Server"
			}
		},
		{
			"label": "build (service)",
			"command": "dotnet",
			"args": [
				"build",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"type": "process",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$msCompile",
			"options": {
				"cwd": "${workspaceFolder}/PhotoSense.Server"
			}
		},
		{
			"label": "build:solution",
			"type": "shell",
			"command": "dotnet build PhotoSense.sln",
			"group": "build",
			"problemMatcher": ["$msCompile"],
			"presentation": { "reveal": "silent", "panel": "dedicated" }
		},
		{
			"label": "run:service",
			"type": "shell",
			"command": "dotnet run --project PhotoSense.Server",
			"problemMatcher": []
		},
		{
			"label": "run:react",
			"type": "shell",
			"command": "npm run dev",
			"options": { "cwd": "${workspaceFolder}/PhotoSense.ReactUI" },
			"problemMatcher": []
		},
		{
			"label": "run:service+react",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -File ./dev-start.ps1 -Open",
			"osx": { "command": "pwsh -File ./dev-start.ps1 -Open" },
			"linux": { "command": "pwsh -File ./dev-start.ps1 -Open" },
			"problemMatcher": []
		},
		{
			"label": "dev:start",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -File ./dev-start.ps1 -Open",
			"osx": { "command": "pwsh -File ./dev-start.ps1 -Open" },
			"linux": { "command": "pwsh -File ./dev-start.ps1 -Open" },
			"problemMatcher": []
		},
		{
			"label": "publish:program",
			"type": "shell",
			"command": "pwsh -File ./publish.ps1",
			"problemMatcher": []
		}
	]
}
