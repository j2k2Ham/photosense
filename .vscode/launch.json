{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch the Trovolve service",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build (service)",
            "program": "${workspaceFolder}/Trovolve.Server/bin/Debug/net11.0/Trovolve.Server.dll",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Attach to the Trovolve service",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
