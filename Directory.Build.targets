<Project>
  <!-- Every program is numbered from version.json and the repository's history by tools/version.mjs: 1.2.0.57 for an
       ordinary build (57 commits so far), 1.2.0 for the release itself (dotnet build -p:TrovolveRelease=true, or a
       commit tagged v1.2.0). A program names itself with TrovolvePart; the libraries take the linked version. -->
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="TrovolveVersion" BeforeTargets="PrepareForBuild;GetAssemblyVersion">
    <PropertyGroup>
      <_TrovolveVersionArguments>--format msbuild --part "$(TrovolvePart)"</_TrovolveVersionArguments>
      <_TrovolveVersionArguments Condition="'$(TrovolveRelease)' == 'true'">$(_TrovolveVersionArguments) --release</_TrovolveVersionArguments>
    </PropertyGroup>
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)tools/version.mjs&quot; $(_TrovolveVersionArguments)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_TrovolveVersionOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_TrovolveVersionExit" />
    </Exec>
    <!-- Without Node (9009 from cmd, 127 from a shell) there is no page to build either; the program is numbered 0. -->
    <Error Condition="'$(_TrovolveVersionExit)' != '0' and '$(_TrovolveVersionExit)' != '9009' and '$(_TrovolveVersionExit)' != '127'"
           Text="$(_TrovolveVersionOutput)" />
    <PropertyGroup Condition="'$(_TrovolveVersionExit)' == '0'">
      <Version>$(_TrovolveVersionOutput.Split(';')[0])</Version>
      <TrovolveBuild>$(_TrovolveVersionOutput.Split(';')[1])</TrovolveBuild>
      <InformationalVersion>$(_TrovolveVersionOutput.Split(';')[2])</InformationalVersion>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).$(TrovolveBuild)</FileVersion>
      <!-- On an iPhone: the version people see (three numbers) and the build, which must rise with every upload. -->
      <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
      <ApplicationVersion>$(TrovolveBuild)</ApplicationVersion>
    </PropertyGroup>
    <Message Importance="normal" Text="$(MSBuildProjectName) is version $(InformationalVersion)" Condition="'$(_TrovolveVersionExit)' == '0'" />
  </Target>
</Project>
