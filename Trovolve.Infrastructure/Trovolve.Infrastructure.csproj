<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(TrovolveSharedTargets)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trovolve.Domain\Trovolve.Domain.csproj" />
    <ProjectReference Include="..\Trovolve.Application\Trovolve.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Place names for where a picture was taken: GeoNames cities1000, CC BY 4.0 (see Places/README.md). -->
    <EmbeddedResource Include="Places\places.tsv.gz" />
    <EmbeddedResource Include="Places\landmarks.tsv.gz" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.8" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <!-- The program's log, for a phone's own composition and the log file every program keeps. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
